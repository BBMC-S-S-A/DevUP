{
  "name": "@devup/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:enlaces": "tsx src/lib/enlaces.test.ts",
    "test:fechas": "tsx src/lib/fechas.test.ts",
    "test:dinero": "tsx src/lib/dinero.test.ts",
    "test:trazado": "tsx src/components/arquitectura/Enlaces.test.ts",
    "test:invitacion": "tsx --tsconfig tsconfig.json src/lib/invitacion.test.ts",
    "test:agente-ia": "tsx --tsconfig tsconfig.json src/lib/world/agente-ia.test.ts",
    "test:tablero-teclado": "tsx --tsconfig tsconfig.json src/lib/tablero-teclado.test.ts",
    "test:riel": "tsx --tsconfig tsconfig.json src/lib/riel.test.ts",
    "test:quien-entro": "tsx --tsconfig tsconfig.json src/lib/quien-entro.test.ts",
    "test:actividad": "tsx --tsconfig tsconfig.json src/lib/actividad.test.ts",
    "test:espacios": "tsx --tsconfig tsconfig.json src/lib/espacios-por-organizacion.test.ts",
    "test:dispositivos": "tsx --tsconfig tsconfig.json src/lib/dispositivos.test.ts",
    "test:recorrido": "tsx --tsconfig tsconfig.json src/lib/recorrido.test.ts",
    "test:salud": "tsx --tsconfig tsconfig.json src/lib/salud.test.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@opennextjs/cloudflare": "^1.20.5",
    "@webcontainer/api": "^1.5.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.128.0"
  }
}
