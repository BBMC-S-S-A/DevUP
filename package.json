{
  "name": "devup",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mcp"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace apps/api",
    "db:reset": "npm run migrate:reset --workspace apps/api",
    "test:rls": "npm run test:rls --workspace apps/api",
    "test:github": "npm run test:github --workspace apps/api",
    "test:integraciones": "npm run test:integraciones --workspace apps/api",
    "test:migraciones": "npm run test:migraciones --workspace apps/api",
    "test:world": "npm run test:world --workspace apps/api",
    "respaldo:ahora": "docker compose --env-file .env.production -f docker-compose.prod.yml exec -T respaldo-base-de-datos sh scripts/respaldo-base-de-datos.sh",
    "respaldo:probar": "docker compose --env-file .env.production -f docker-compose.prod.yml exec -T respaldo-base-de-datos sh scripts/probar-restauracion.sh",
    "grafo": "node scripts/grafo.mjs",
    "doc:pdf": "node scripts/md-a-pdf.mjs",
    "correo:probar": "node scripts/probar-correo.mjs",
    "boveda:rotar": "node scripts/rotar-clave-boveda.mjs",
    "respaldo:almacen": "docker compose --env-file .env.production -f docker-compose.prod.yml exec -T respaldo-almacen sh scripts/respaldo-almacen.sh",
    "supabase:comprobar": "node scripts/comprobar-supabase.mjs",
    "test:google": "npm run test:google --workspace apps/api",
    "test:youtube": "npm run test:youtube --workspace apps/api",
    "test:puerta": "npm run test:puerta --workspace apps/api",
    "test:mcp": "npm run test:mcp --workspace apps/mcp",
    "test:codigo": "npm run test:codigo --workspace apps/api",
    "test:asistente": "npm run test:asistente --workspace apps/api",
    "test:web": "npm run test:enlaces --workspace apps/web && npm run test:fechas --workspace apps/web && npm run test:dinero --workspace apps/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json"
  },
  "engines": {
    "node": ">=20.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
