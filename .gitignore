# Los respaldos nunca entran en git: llevan dentro los datos de producción.
/respaldos/

# Configuración local de herramientas: rutas y puertos de la máquina de cada
# cual, no del proyecto.
.claude/

# Productos intermedios del generador de la propuesta: las fuentes se bajan del
# paquete oficial y los PNG los dibujan logo.py y modelo3d.py. Se regeneran en
# dos comandos, así que versionar binarios que no son nuestros no aporta nada.
docs/propuesta/fuentes/
docs/propuesta/package/
docs/propuesta/*.tgz
docs/propuesta/*.png
docs/propuesta/__pycache__/

# Vista previa temporal de artefactos, no forma parte del proyecto.
.grafo-preview.html

# Copias de seguridad que hago yo mismo antes de tocar secretos; nunca al repo.
.env.*.antes-*

# Salida del adaptador de Cloudflare (OpenNext), se genera con cada build.
.open-next
.wrangler
apps/web/.dev.vars
design/

# El archivo con el token de la conexion de agente vive en el disco de cada
# persona (~/.devup/mcp.json), no aqui. Esto es por si alguien apunta
# DEVUP_CONFIG dentro del repo mientras prueba.
mcp.json
# Artefactos de las pruebas de extremo a extremo (tests/e2e/, playwright.config.ts).
# `tests/.auth/` lleva la sesión de la cuenta sembradora — cookies de verdad,
# nunca al repo. Los otros dos son informes que se regeneran en cada corrida.
tests/.auth/
playwright-report/
test-results/
blob-report/
