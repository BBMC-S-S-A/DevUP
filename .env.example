# =============================================================================
# DevUP — variables de entorno
#
# Copia este archivo a .env y rellénalo. Los valores por defecto corresponden
# a `docker compose up -d`, así que en local funciona tal cual.
# =============================================================================

# --- Base de datos ----------------------------------------------------------
# ADMIN es el propietario del esquema: solo lo usa el runner de migraciones.
# La API se conecta con DATABASE_URL, cuyo rol NO es propietario de las tablas
# y por eso RLS sí se le aplica. Si la API usara el rol propietario, las
# políticas se saltarían en silencio y el aislamiento entre organizaciones
# dejaría de existir sin que nada fallara. No las intercambies.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/devup
DATABASE_URL=postgres://devup_app:devup-app-local-secret@localhost:5432/devup
APP_DB_PASSWORD=devup-app-local-secret

# --- Sesiones ---------------------------------------------------------------
# Firma los JWT de sesión. En producción, 32 bytes aleatorios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=cambiame-en-produccion-por-32-bytes-aleatorios
# Duración del token de acceso y del de refresco.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Marca las cookies como Secure. Déjalo en false solo para http://localhost.
COOKIE_SECURE=false

# Cifra la bóveda de credenciales (el token de GitHub de una organización, el
# de Spotify de una persona). Tiene que ser exactamente 32 bytes en base64, no
# cualquier cadena como AUTH_SECRET. En producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=ISL/c4r0CmSwLDWakAZYc5Hda7maptiLU0F+gHAqh+0=

# --- Altas --------------------------------------------------------------------
# `invite`: solo se entra con una invitación. La primera cuenta de la instancia
# es la excepción, porque si no nadie podría invitar a nadie.
# `open`: cualquiera con la URL puede registrarse. Solo tiene sentido en una
# instancia pública, y no es lo que DevUP pretende ser.
SIGNUP_MODE=invite
REQUIRE_EMAIL_VERIFICATION=false

# --- Correo -------------------------------------------------------------------
# Sin SMTP, los correos se escriben en el registro con su enlace: sirve para
# probar invitaciones y recuperación en desarrollo. En producción la API avisa
# al arrancar de que no está configurado.
# SMTP_URL=smtp://usuario:clave@smtp.proveedor.com:587
#
# Para probarlo en local sin credenciales de nadie hay un buzón de mentira en el
# compose de desarrollo. Habla SMTP de verdad —se autentica, compone, acepta o
# rechaza— y enseña lo recibido en http://localhost:8025:
#
#   docker compose up -d mailpit
#   SMTP_URL=smtp://localhost:1025
#
# Y con esto se comprueba de una vez, con o sin buzón de mentira:
#   npm run correo:probar -- tu@correo.com
MAIL_FROM=DevUP <no-reply@devup.local>

# Base pública de la web. De aquí salen los enlaces de los correos, así que en
# producción tiene que ser https: son credenciales de un solo uso.
APP_BASE_URL=http://localhost:3000

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Orígenes autorizados para CORS, separados por coma.
WEB_ORIGIN=http://localhost:3000

# --- Almacenamiento S3-compatible -------------------------------------------
# MinIO en local; en producción, R2 / S3 / el bucket del cliente.
# La dirección pública: es la que llevan las URLs firmadas, y la abre el
# navegador de cada persona.
S3_ENDPOINT=http://localhost:9000

# Por dónde habla el servidor con el almacén cuando se pregunta a sí mismo
# (¿llegó la subida?, borra esto, prepara el bucket). En desarrollo es la misma
# y se deja sin poner. En un despliegue con contenedores, la de la red interna:
#
#   S3_ENDPOINT_INTERNO=http://minio:9000
#
# Sin esto, comprobar una subida sale a internet y vuelve —50 veces más lento— y
# un corte ahí fuera se convierte en «la subida no llegó a completarse» sobre un
# archivo que está perfectamente guardado.
# S3_ENDPOINT_INTERNO=
S3_REGION=us-east-1
S3_BUCKET=devup-files
S3_ACCESS_KEY_ID=devup
S3_SECRET_ACCESS_KEY=devup-local-secret
# MinIO necesita path-style; S3 y R2 funcionan con virtual-hosted.
S3_FORCE_PATH_STYLE=true
# Caducidad de las URLs firmadas, en segundos.
S3_SIGNED_URL_TTL=900
# Tamaño máximo por archivo, en bytes (100 MB).
MAX_UPLOAD_BYTES=104857600

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Voz --------------------------------------------------------------------
# STUN basta cuando ambos extremos pueden abrir un camino directo. En redes
# corporativas, con NAT simétrico o detrás de algunos móviles, hace falta TURN:
# sin él la llamada conecta la señalización pero no llega el audio. Es el fallo
# número uno de este tipo de sistema.
#
# Opcional en desarrollo dentro de la misma red. Obligatorio en producción.
# Los servidores ICE los sirve la API en /calls/ice-servers, no el bundle del
# navegador: una credencial de TURN en una variable NEXT_PUBLIC_ es un relé
# abierto para cualquiera que abra las herramientas de desarrollo.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Vacío = sin TURN. En producción es obligatorio; ver docs/TURN.md.
TURN_URLS=
# TURN_URLS=turn:turn.tu-dominio:3478,turns:turn.tu-dominio:443

# En producción: secreto compartido con coturn (--use-auth-secret). La API
# emite credenciales firmadas con caducidad y el navegador nunca ve el secreto.
TURN_SECRET=
TURN_TTL_SECONDS=43200

# Solo para el coturn de desarrollo de docker-compose, que usa credencial fija.
# Descomenta junto con TURN_URLS=turn:localhost:3478 para probar el relé.
# TURN_STATIC_USERNAME=devup
# TURN_STATIC_CREDENTIAL=devup-turn-local
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=

# TURN gestionado (Metered.ca). Si METERED_API_KEY está puesta, tiene
# preferencia sobre todo lo de arriba: cada llamada pide una credencial nueva a
# su API, así que aquí no se guarda ningún secreto fijo.
#
# ES LA ÚNICA OPCIÓN CON EL DESPLIEGUE DE HOY. Producción no publica ningún
# puerto —todo entra por el túnel de Cloudflare, que es un proxy de HTTP— así
# que un coturn propio no lo alcanzaría nadie desde fuera. Ver docs/TURN.md.
METERED_APP_NAME=
METERED_API_KEY=
